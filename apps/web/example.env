
# ─── Supabase (New key format) ────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API → Publishable and secret API keys

# Browser-safe publishable key (safe to commit as NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # sb_publishable_* key

# Server-side only — NEVER expose to the browser
SUPABASE_SECRET_KEY=                    # sb_secret_* key

# ─── Optional: Legacy JWT keys (fallback only) ──────────────────────────────
# Only needed if you are NOT using the new key format above
# SUPABASE_SERVICE_ROLE_KEY=            # eyJ... JWT from "Legacy anon, service_role API keys" tab

# ─── App ─────────────────────────────────────────────────────────────────────
GREENFIELD_PROD_URL=