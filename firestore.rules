rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get user data from the users collection
    // Note: This incurs a document read charge.
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper function to check if user has a specific role
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    // ---------------------------------------------------------
    // Users Collection
    // ---------------------------------------------------------
    match /users/{userId} {
      // Users can read their own profile. Admins and Managers can read all profiles.
      allow read: if isAuthenticated() && (request.auth.uid == userId || hasRole('Admin') || hasRole('Manager'));
      
      // Only Admins can create or update user roles/profiles to prevent privilege escalation.
      allow write: if hasRole('Admin');
    }

    // ---------------------------------------------------------
    // Core Collections
    // ---------------------------------------------------------

    // Farmers
    match /farmers/{farmerId} {
      allow read: if isAuthenticated();
      // Employees (field agents) need full CRUD access to manage farmers.
      // Admins can also manage farmers for oversight.
      allow create, update, delete: if isAuthenticated() && (hasRole('Employee') || hasRole('Admin'));
    }

    // Employees
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      // Only Admins (CEO) can create, update, or delete employee records.
      // Employees can update their own profile.
      allow update: if isAuthenticated() && (request.auth.uid == employeeId || hasRole('Admin'));
      allow create, delete: if hasRole('Admin');
    }

    // Products
    match /products/{productId} {
      allow read: if isAuthenticated();
      // Employees and Admins have full CRUD access to products.
      allow create, update, delete: if isAuthenticated() && (hasRole('Employee') || hasRole('Admin'));
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read: if isAuthenticated();
      // Employees and Admins have full CRUD access to suppliers.
      allow create, update, delete: if isAuthenticated() && (hasRole('Employee') || hasRole('Admin'));
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      // Employees and Admins have full CRUD access to transactions.
      allow create, update, delete: if isAuthenticated() && (hasRole('Employee') || hasRole('Admin'));
    }
  }
}
