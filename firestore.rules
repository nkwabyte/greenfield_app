rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get user data from the users collection
    // Note: This incurs a document read charge.
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper function to check if user has a specific role
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    // ---------------------------------------------------------
    // Users Collection
    // ---------------------------------------------------------
    match /users/{userId} {
      // Users can read their own profile. Admins and Managers can read all profiles.
      allow read: if isAuthenticated() && (request.auth.uid == userId || hasRole('Admin') || hasRole('Manager'));
      
      // Only Admins can create or update user roles/profiles to prevent privilege escalation.
      allow write: if hasRole('Admin');
    }

    // ---------------------------------------------------------
    // Core Collections
    // ---------------------------------------------------------

    // Farmers
    match /farmers/{farmerId} {
      allow read: if isAuthenticated();
      // Allow create/update if authenticated. 
      // Delete restricted to Admins or Managers.
      allow create, update: if isAuthenticated();
      allow delete: if hasRole('Admin') || hasRole('Manager');
    }

    // Employees
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      // Only Admins and Managers can manage employee records.
      allow write: if hasRole('Admin') || hasRole('Manager');
    }

    // Products
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if hasRole('Admin') || hasRole('Manager');
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if hasRole('Admin') || hasRole('Manager');
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      // Financial records should be strictly controlled.
      // Assuming all authenticated users can record transactions (e.g. sales), 
      // but maybe only Accountants/Managers can delete or edit past dates?
      // For now, allow create/update for all, restrict delete.
      allow create, update: if isAuthenticated();
      allow delete: if hasRole('Admin') || hasRole('Manager') || hasRole('Accountant');
    }
  }
}
